CH_HOST=localhost
CH_PORT=8123
CH_USER=clickliv
CH_PASSWORD=clickliv
CH_DATABASE=clickliv
CH_SECURE=0

# ClickHouse Cloud
# CH_HOST=<service>.<region>.<provider>.clickhouse.cloud
# CH_PORT=8443
# CH_USER=default
# CH_PASSWORD=<password>
# CH_SECURE=1

MARTS_PASSWORD=change-me

# ClickStack. Unset means tracing is off and the pipeline is unchanged.
# The key is the HyperDX ingestion API key, from Team Settings at localhost:8080.
# CLICKSTACK_OTLP=http://localhost:4318
# CLICKSTACK_KEY=<ingestion-api-key>

# Optional: decline-alert narration (make decline). Unset means deterministic
# detection only, no LLM call, no difference in output beyond the missing
# narration line. Bedrock API key from console.aws.amazon.com, Amazon Bedrock ->
# API keys. Claude is not reachable via Bedrock in ap-south-1 on this account
# (D30); openai.gpt-oss-120b through the OpenAI-compatible endpoint is, and is
# what bedrock.py calls.
# AWS_BEARER_TOKEN_BEDROCK=<bedrock-api-key>
# AWS_REGION=ap-south-1

RAW_CSV=data/ch-hackathon-raw-data.csv
CONTENT_CSV=data/ch-hackathon-content-data.csv
