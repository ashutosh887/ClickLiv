CH_HOST=localhost
CH_PORT=8123
CH_USER=clickliv
CH_PASSWORD=clickliv
CH_DATABASE=clickliv
CH_SECURE=0

# ClickHouse Cloud, the submission's actual requirement ("load the dataset into
# your team's own ClickHouse Cloud service, there is no shared instance"). Comment
# the block above and uncomment this one. Host/password from the Cloud console
# (Connect page) or `clickhousectl cloud service reset-password <id>`.
# CH_HOST=<service>.<region>.<provider>.clickhouse.cloud
# CH_PORT=8443
# CH_USER=default
# CH_PASSWORD=<password>
# CH_SECURE=1

# The MCP server (make mcp, docker-compose clickhouse-mcp) authenticates as a
# separate least-privilege role, never the admin default user: read-only on
# clickliv/marts, with a query budget. Create it once against the Cloud service:
#   CREATE ROLE mcp_readonly;
#   GRANT SELECT ON clickliv.* TO mcp_readonly;
#   GRANT SELECT ON marts.* TO mcp_readonly;
#   CREATE SETTINGS PROFILE mcp_budget SETTINGS readonly = 1 CONST,
#     max_execution_time = 20 CONST, max_memory_usage = 2000000000 CONST,
#     max_rows_to_read = 200000000 CONST, max_result_rows = 10000 CONST,
#     max_threads = 4 CONST TO mcp_readonly;
#   CREATE USER mcp_agent IDENTIFIED WITH sha256_password BY '<password>'
#     DEFAULT ROLE mcp_readonly SETTINGS PROFILE mcp_budget;
# CH_MCP_USER=mcp_agent
# CH_MCP_PASSWORD=<password>

# Cloud enforces a password policy (uppercase + digit + special character) that
# local Docker does not; a Cloud-safe value works on both, so one value is enough.
MARTS_PASSWORD=Change-Me-1!

# The public web app (web/, deployed to Vercel) authenticates as marts_agent too,
# never as the admin default user. Its Vercel production environment needs exactly
# two variables, CH_HOST and MARTS_PASSWORD. The username and the database are
# fixed in web/api/_clickhouse.js, so no environment setting can widen them:
#   vercel env add CH_HOST production
#   vercel env add MARTS_PASSWORD production

# ClickStack. Unset means tracing is off and the pipeline is unchanged.
# The key is the HyperDX ingestion API key, from Team Settings at localhost:8080.
# CLICKSTACK_OTLP=http://localhost:4318
# CLICKSTACK_KEY=<ingestion-api-key>

# Optional: LLM narration (make decline) and the LibreChat model provider. Unset
# means deterministic detection only, no LLM call, no difference in output beyond
# the missing narration line. OpenAI is preferred when both are set; Bedrock stays
# a working fallback. Claude is not reachable via Bedrock on this account in
# ap-south-1 (D30), openai.gpt-oss-120b through the OpenAI-compatible endpoint is.
# GOOGLE_KEY=<aistudio.google.com key>
# GOOGLE_MODEL=gemini-3-flash-preview
# OPENAI_API_KEY=<platform.openai.com key>
# OPENAI_MODEL=gpt-5.2
# AWS_BEARER_TOKEN_BEDROCK=<bedrock-api-key>
# AWS_REGION=ap-south-1

# LibreChat, the conversational pillar (make chat-up). It cannot generate these
# four itself. Make each with `openssl rand -hex 32`; CREDS_IV wants 16 bytes,
# so `openssl rand -hex 16`. Required whenever the chat profile is up.
# LIBRECHAT_CREDS_KEY=<64 hex chars>
# LIBRECHAT_CREDS_IV=<32 hex chars>
# LIBRECHAT_JWT_SECRET=<64 hex chars>
# LIBRECHAT_JWT_REFRESH_SECRET=<64 hex chars>

# Langfuse, the LLM-observability pillar (make llm-up, D34). Traces go to the
# ClickHouse Cloud service above, database langfuse; state goes to ClickHouse
# managed Postgres, created with `clickhousectl cloud postgres create`; blobs go
# to an S3 bucket. Generate the secrets with `openssl rand -hex 16` (32 for
# ENCRYPTION_KEY). Unset LANGFUSE_HOST and the Langfuse sink is simply off.
# LANGFUSE_HOST=http://localhost:3300
# LANGFUSE_PUBLIC_KEY=pk-lf-clickliv
# LANGFUSE_SECRET_KEY=sk-lf-<random>
# LANGFUSE_DATABASE_URL=postgresql://postgres:<pw>@<service>.<region>.aws.pg.clickhouse.cloud:5432/langfuse?sslmode=require
# LANGFUSE_INIT_USER_EMAIL=<you@example.com>
# LANGFUSE_INIT_USER_PASSWORD=<password>
# LANGFUSE_REDIS_AUTH=<random>
# LANGFUSE_SALT=<random>
# LANGFUSE_ENCRYPTION_KEY=<64 hex chars>
# LANGFUSE_NEXTAUTH_SECRET=<random>
# LANGFUSE_S3_BUCKET=<bucket>
# LANGFUSE_S3_REGION=ap-south-1
# LANGFUSE_S3_KEY=<scoped IAM access key id>
# LANGFUSE_S3_SECRET=<scoped IAM secret>

# The MCP server port (make mcp). docker/librechat.yaml expects 8765.
# MCP_PORT=8765

RAW_CSV=data/ch-hackathon-raw-data.csv
CONTENT_CSV=data/ch-hackathon-content-data.csv

# The dashboard port (make ui). 8765 belongs to the MCP server.
# UI_PORT=8090
