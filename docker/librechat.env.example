# LibreChat requires these four values and cannot generate them itself.
# Generate each with `openssl rand -hex 32` (CREDS_IV wants 16 bytes: `openssl rand -hex 16`).
# The real file, docker/librechat.env, is gitignored. Every other secret reaches
# the container through ${VAR} substitution from .env instead.
CREDS_KEY=<64 hex chars>
CREDS_IV=<32 hex chars>
JWT_SECRET=<64 hex chars>
JWT_REFRESH_SECRET=<64 hex chars>
