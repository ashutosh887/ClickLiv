CH_HOST=<service>.<region>.aws.clickhouse.cloud
CH_PORT=8443
CH_USER=default
CH_PASSWORD=<service password, from Connect or clickhousectl cloud service reset-password>
CH_DATABASE=clickliv
CH_SECURE=1

RAW_CSV=data/ch-hackathon-raw-data.csv
CONTENT_CSV=data/ch-hackathon-content-data.csv

# Cloud enforces a password policy (uppercase + digit + special character) that
# local Docker does not. The local placeholder in .env.example will be rejected here.
MARTS_PASSWORD=<something that satisfies Cloud's password policy>

# Optional: decline-alert narration (make decline). See .env.example for details.
# AWS_BEARER_TOKEN_BEDROCK=<bedrock-api-key>
# AWS_REGION=ap-south-1
